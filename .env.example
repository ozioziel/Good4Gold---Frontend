# Variables del despliegue con docker compose (copia como .env; nunca lo subas a git).

# Base de datos: genera una con  openssl rand -base64 24
POSTGRES_PASSWORD=
# Firma de tokens: genera uno con  openssl rand -base64 32
JWT_SECRET=
AUTH_MODE=demo
MARCA=Gold2Life
# 1 = carga las semillas (lugares reales sin resultados + datos DEMO). Son idempotentes.
SEMILLAS=1

# Web: puerto público de nginx. Con HTTPS (perfil «https»), usa otro (p. ej. 8080) y deja el 80/443 a Caddy.
PUERTO_WEB=80
# Dominio para HTTPS con Caddy (perfil «https»)
DOMINIO=
# Orígenes permitidos si el frontend se sirve desde otro dominio (con /api en el mismo dominio no hace falta)
CORS_ORIGINS=http://localhost

# Escrow en Stellar TESTNET (ver contracts/escrow/README.md). Vacío = campañas desactivadas (503).
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
ESCROW_CONTRACT_ID=
USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
STELLAR_ADMIN_SECRET=
STELLAR_VERIFICADOR_SECRET=
STELLAR_ORG_DEMO_PUBLIC=
STELLAR_DONANTE_DEMO_SECRET=
