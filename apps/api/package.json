{
  "name": "@gold2/api",
  "private": true,
  "version": "0.1.0",
  "description": "API de Gold2Life: comunidad, solicitudes, mediciones y sincronización sin conexión.",
  "type": "commonjs",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrar": "node --env-file-if-exists=.env scripts/migrar.mts",
    "db:semillas": "node --env-file-if-exists=.env scripts/migrar.mts --semillas",
    "dev": "npm run build && (swc src -d dist --strip-leading-paths -w --quiet & node --watch --env-file-if-exists=.env dist/main.js)",
    "build": "rm -rf dist && swc src -d dist --strip-leading-paths",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.6.3",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.3",
    "@nestjs/core": "^12.6.3",
    "@nestjs/platform-express": "^12.6.3",
    "@stellar/stellar-sdk": "^17.4.0",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}
