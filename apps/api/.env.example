# Copia este archivo como .env (no se sube a git). Sin credenciales reales.
PORT=3000
# Base local de docker-compose.yml
DATABASE_URL=postgres://gold2:gold2_local@127.0.0.1:5433/gold2
# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# demo: el visitante elige un rol DEMO y recibe un token firmado aquí. (supabase: pendiente)
AUTH_MODE=demo
# Secreto para firmar tokens de demostración. Genera uno con: openssl rand -base64 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
# Marca provisional (configurable)
MARCA=Gold2Life

# Stellar TESTNET (escrow por hitos, contracts/escrow). Sin estas variables, las campañas responden 503.
# Genera cuentas con: stellar keys generate <nombre> --network testnet --fund
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_RED=testnet
ESCROW_CONTRACT_ID=
# USDC de prueba de Circle en testnet (emisor GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5)
USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# Administración de la plataforma: crea y cancela campañas en el contrato.
STELLAR_ADMIN_SECRET=
# DEMO: el verificador independiente firma con una clave que custodia el servidor. En producción firma con su billetera.
STELLAR_VERIFICADOR_SECRET=
# Cuenta que recibe los hitos cuando la organización no indica la suya (DEMO).
STELLAR_ORG_DEMO_PUBLIC=
# DEMO: donante de prueba custodiado por el servidor (POST /campaigns/:id/donations/demo).
STELLAR_DONANTE_DEMO_SECRET=
